<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit.Analyzers" Version="3.9.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Shared/Shared.csproj" />
  </ItemGroup>

  <!-- HarnessRuntime lives in Mod/ but takes no Verse dependency of its own, and its ForcedLatitude
       setter carries the fire-on-change logic deciding whether a mod's cache gets flushed. Linked
       rather than copied so these tests compile the exact file that ships, per the same argument
       CelestialLighting's Formulas.cs makes. A ProjectReference to Mod.csproj would instead drag the
       whole game-coupled assembly in and cost these tests their offline-ness. -->
  <ItemGroup>
    <Compile Include="../../Mod/HarnessRuntime.cs" Link="Linked/HarnessRuntime.cs" />
  </ItemGroup>

</Project>
